{
  "version": 1,
  "hooks": {
    "postToolUse": [
      {
        "matcher": "Read|Grep|Glob|Search|Shell",
        "command": "node .claude/helpers/graft-hooks.cjs cursor-post-tool"
      }
    ],
    "afterMCPExecution": [
      {
        "command": "node .claude/helpers/graft-hooks.cjs cursor-mcp"
      }
    ],
    "sessionEnd": [
      {
        "command": "node .claude/helpers/graft-hooks.cjs cursor-session-end"
      }
    ]
  }
}
