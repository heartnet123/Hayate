{
  "name": "helpdeskai",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "typescript": "^6.0.3"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev -F web --",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "devDependencies": {
    "@helpdeskai/config": "workspace:*",
    "@types/node": "^26.4.1",
    "oxfmt": "latest",
    "oxlint": "latest",
    "turbo": "^2.10.12",
    "typescript": "catalog:",
    "ultracite": "7.11.0"
  },
  "packageManager": "bun@1.4.1"
}
